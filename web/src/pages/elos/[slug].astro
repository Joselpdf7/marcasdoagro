---
import { url } from "../../lib/url.ts";
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Spark from "../../components/Spark.astro";
import SubMatrix from "../../components/SubMatrix.astro";
import Triangle from "../../components/Triangle.astro";
import Canais from "../../components/Canais.astro";
import { elos, eloBySlug, ranked, pillarsPayload, positionsPayload, dumbbellPayload, brandUrl } from "../../lib/data.ts";
import { PILARES } from "../../lib/meta.ts";
import { fatia, pct, compact, int } from "../../lib/format.ts";

export function getStaticPaths() {
  return elos.map((e) => ({ params: { slug: e.slug } }));
}

const e = eloBySlug(Astro.params.slug!);
const r = ranked(e);
const comTotal = r.filter((m) => m.total !== null);
const maxTotal = Math.max(...comTotal.map((m) => m.total!));
const semTotal = r.filter((m) => m.total === null);
const pillarMax = Math.max(...e.marcas.flatMap((m) => Object.values(m.pilares).filter((v): v is number => v !== null))) * 1.05;
const unidade = e.unidade === "grupo" ? "grupos" : "marcas";
---
<Base title={e.nome} section="elos" description={`Painel de presença digital de ${e.nome}: ${e.marcas.length} ${unidade}, líder ${r[0]?.nome}.`}>
  <section class="page" style="padding-top: 56px; padding-bottom: 24px;">
    <p class="breadcrumb"><a href={url("/")}>Panorama</a> / <a href={url("/elos/")}>Setores</a> / {e.nome}</p>
    <p class="kicker">{e.marcas.length} {unidade}</p>
    <h1 style="font-size: clamp(40px, 6vw, 76px);">{e.nome}</h1>
    <p class="lead" style="margin-top:14px;">Quanto maior o triângulo, mais forte a marca no digital. O número é a fatia de cada uma no setor.</p>
    <ul class="legend tri-legend">
      {PILARES.map((p) => <li><span class="swatch" style={`background:var(--p-${p.id})`}></span>{p.simples}</li>)}
      <li><span class="swatch line" style="background:none;border-top:1px dashed var(--ink-3);"></span>média do setor</li>
    </ul>
    <div class="tris">
      {r.map((m, i) => (
        <Triangle nome={m.nome} href={brandUrl(e, m)} pilares={m.pilares} total={m.total} max={pillarMax} referencia={e.referencia} destaque={i === 0} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="page">
      <h2 style="margin-bottom:32px;">Onde cada {e.unidade} aparece</h2>
      <Canais elo={e} />
    </div>
  </section>

  <section class="section" style="padding-top:0;border-top:0;">
    <div class="page">
      <details class="data-table">
        <summary>Ver a tabela completa</summary>
      <div class="table-wrap" style="margin-top: 32px;">
        <table class="t" data-sortable>
          <thead>
            <tr>
              <th class="num" aria-sort="ascending"><button type="button" data-col="0" data-type="num">Posição</button></th>
              <th><button type="button" data-col="1" data-type="text">{e.unidade === "grupo" ? "Grupo" : "Marca"}</button></th>
              <th class="num"><button type="button" data-col="2" data-type="num">Fatia</button></th>
              <th></th>
              {PILARES.map((p, i) => <th class="num"><button type="button" data-col={String(4 + i)} data-type="num">{p.simples}</button></th>)}
              <th class="num"><button type="button" data-col="7" data-type="num">Citada pelas IAs</button></th>
              <th class="num"><button type="button" data-col="8" data-type="num">Responde comentários</button></th>
              <th class="num"><button type="button" data-col="9" data-type="num">Buscas gerais</button></th>
              <th class="num"><button type="button" data-col="10" data-type="num">Imprensa</button></th>
              <th class="num"><button type="button" data-col="11" data-type="num">Instagram</button></th>
            </tr>
          </thead>
          <tbody>
            {r.map((m, i) => (
              <tr>
                <td class="num" data-v={m.posicaoModal ?? 99}>{m.posicaoModal ?? <span class="na">—</span>}</td>
                <td class="name" data-v={m.nome}><a href={brandUrl(e, m)}>{m.nome}</a></td>
                <td class="num" data-v={m.total ?? -1}>{m.total === null ? <span class="na">sem nota</span> : fatia(m.total)}</td>
                <td><Spark value={m.total} max={maxTotal} reference={e.referencia} highlight={i === 0} /></td>
                {PILARES.map((p) => <td class="num" data-v={m.pilares[p.id] ?? -1}>{fatia(m.pilares[p.id])}</td>)}
                <td class="num" data-v={m.ia.mencao ?? -1}>{pct(m.ia.mencao)}</td>
                <td class="num" data-v={m.resposta.porComentario ?? -1}>{pct(m.resposta.porComentario)}</td>
                <td class="num" data-v={m.categoriaTop10 ?? -1}>{pct(m.categoriaTop10)}</td>
                <td class="num" data-v={m.materias ?? -1}>{int(m.materias)}</td>
                <td class="num" data-v={m.seguidores.instagram ?? -1}>{compact(m.seguidores.instagram)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {semTotal.length > 0 && <p class="fig-caption">{semTotal.map((m) => m.nome).join(" e ")} ficam sem nota porque não têm perfis próprios nas redes para medir a conversa com o público.</p>}
      </details>
    </div>
  </section>

  <section class="section">
    <div class="page grid-2">
      <div>
        <h3>Pontos fortes e fracos</h3>
        <p class="muted small" style="margin-top:10px;">Cada cor é um pilar. O traço é a fatia total.</p>
        <Chart payload={pillarsPayload(e)} label={`Participação por pilar em ${e.nome}`}>
          <ul slot="legend" class="legend" style="margin-top:14px;">
            {PILARES.map((p) => <li><span class="swatch" style={`background:var(--p-${p.id})`}></span>{p.simples}</li>)}
            <li><span class="swatch line" style="background:var(--ink);width:2px;height:12px;"></span>Fatia total</li>
          </ul>
        </Chart>
      </div>
      <div>
        <h3>Quem está empatado</h3>
        <p class="muted small" style="margin-top:10px;">Chance de cada marca ficar em cada posição. Quanto mais escura a célula, mais certa a posição.</p>
        <Chart payload={positionsPayload(e)} label={`Probabilidade por posição em ${e.nome}`} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="prose">
        <h2>Todas as medidas</h2>
        <p class="lead">Barra maior, marca mais forte naquela medida. Em itálico, as medidas que não entram na nota.</p>
      </div>
      <SubMatrix elo={e} />
    </div>
  </section>

  <section class="section">
    <div class="page grid-2">
      <div>
        <h3>Quem as IAs citam</h3>
        <p class="muted small" style="margin-top:10px;">Perguntas de produtor feitas ao ChatGPT, Gemini, Copilot e Claude.</p>
        <Chart payload={dumbbellPayload(e)} label={`Menção e primeira citação pelas IAs em ${e.nome}`}>
          <ul slot="legend" class="legend" style="margin-top:14px;">
            <li><span class="swatch" style="background:var(--brand-ink)"></span>Citada primeiro</li>
            <li><span class="swatch" style="border:1.5px solid var(--ink-2)"></span>Citada</li>
          </ul>
        </Chart>
      </div>
      <div>
        {e.marcas.some((m) => m.submarcas.length) ? (
          <>
            <h3>As marcas de cada grupo</h3>
            <dl style="margin-top:22px;">
              {r.map((m) => (
                <div style="display:grid;grid-template-columns:140px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--rule);">
                  <dt><a href={brandUrl(e, m)}>{m.nome}</a></dt>
                  <dd style="margin:0;color:var(--ink-2);">{m.submarcas.map((s) => s.nome).join(", ")}</dd>
                </div>
              ))}
            </dl>
          </>
        ) : (
          <>
            <h3>Ficou alguma dúvida?</h3>
            <p class="muted" style="margin-top:12px;">Pergunte ao estudo. A resposta vem com a fonte.</p>
          </>
        )}
        <p style="margin-top:28px;"><a class="btn primary" href={url(`/pergunte/?elo=${e.segmento}`)}>Perguntar sobre {e.nome.toLowerCase()}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .tri-legend { margin: 28px 0 8px; }
  .tris {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 36px 28px;
    margin-top: 12px;
  }
</style>

<script>
  // Sortable Tufte table (progressive enhancement; the server order is the study's ranking).
  document.querySelectorAll<HTMLTableElement>("table[data-sortable]").forEach((table) => {
    const tbody = table.tBodies[0];
    if (!tbody) return;
    table.querySelectorAll<HTMLButtonElement>("th button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const col = Number(btn.dataset["col"]);
        const th = btn.parentElement as HTMLElement;
        const asc = th.getAttribute("aria-sort") === "descending" || (th.getAttribute("aria-sort") === null && btn.dataset["type"] === "text");
        table.querySelectorAll("th").forEach((h) => h.removeAttribute("aria-sort"));
        th.setAttribute("aria-sort", asc ? "ascending" : "descending");
        const rows = [...tbody.rows];
        rows.sort((a, b) => {
          const va = a.cells[col]?.dataset["v"] ?? "";
          const vb = b.cells[col]?.dataset["v"] ?? "";
          const cmp = btn.dataset["type"] === "num" ? Number(va) - Number(vb) : va.localeCompare(vb, "pt-BR");
          return asc ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  });
</script>
