---
import { url } from "../lib/url.ts";
import Base from "../layouts/Base.astro";
import Chart from "../components/Chart.astro";
import {
  elos,
  ranked,
  leader,
  pillarLeader,
  panelPayload,
  slopePayload,
  dumbbellPayload,
  stripAcrossElos,
  pressPayload,
  sitePayload,
  positionsPayload,
  shortName,
  brandUrl,
} from "../lib/data.ts";
import { PILARES } from "../lib/meta.ts";
import { fatia, pct, int } from "../lib/format.ts";

const resposta = stripAcrossElos((m) => m.resposta.porComentario, { unit: "%", xMax: 100, labelAbove: 50 });
const categoria = stripAcrossElos((m) => m.categoriaTop10, { unit: "%", xMax: 60, labelAbove: 30 });
const imprensa = pressPayload();

const perguntas = [
  "Quem lidera cada setor?",
  "Quais marcas mais respondem aos comentários no Instagram?",
  "Quais marcas de sementes as IAs citam mais?",
  "Por que Bayer e BASF ficam sem nota nas sementes?",
];
---
<Base title="MarcasdoAgro" section="panorama">
  <section class="page" style="padding-top: clamp(48px, 9vw, 120px); padding-bottom: 72px;">
    <p class="kicker rise">Presença digital do agro brasileiro · 2025 e 2026</p>
    <h1 class="rise d1">Quando o produtor procura,<br /><em>quem ele encontra?</em></h1>
    <p class="lead rise d2">
      Um estudo do Olhar Público sobre como 33 marcas de defensivos, máquinas, fertilizantes e sementes aparecem no Google,
      nas redes sociais, na imprensa e nas respostas de inteligência artificial.
    </p>
    <p class="rise d3" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:34px;">
      <a class="btn primary" href="#paineis">Ver os resultados</a>
      <a class="btn" href={url("/pergunte/")}>Pergunte ao estudo</a>
    </p>
    <div class="stat-row rise d3" role="list">
      <div class="stat" role="listitem"><b>4</b><span>setores do agro</span></div>
      <div class="stat" role="listitem"><b>33</b><span>marcas analisadas</span></div>
      <div class="stat" role="listitem"><b>4</b><span>inteligências artificiais consultadas</span></div>
      <div class="stat" role="listitem"><b>12</b><span>meses de dados</span></div>
    </div>
  </section>

  <section class="section" id="paineis">
    <div class="page">
      <div class="prose">
        <h2>Em cada setor, <em>uma marca lidera.</em></h2>
        <p class="lead">O número mostra a fatia de cada marca na presença digital do setor. A linha tracejada é a média.</p>
      </div>
      <div class="multiples" style="margin-top:44px;">
        {elos.map((e) => {
          const l = leader(e);
          return (
            <div class="multiple">
              <h4><a href={url(`/elos/${e.slug}/`)}>{e.nome}</a><span>ver setor →</span></h4>
              <Chart payload={panelPayload(e)} label={`Fatia de cada marca em ${e.nome}; ${l.nome} lidera com ${fatia(l.total)}`}>
                {e.marcas.some((m) => m.total === null) && (
                  <p slot="caption" class="fig-caption">
                    {e.marcas.filter((m) => m.total === null).map((m) => m.nome).join(" e ")} ficam sem nota: não têm perfis próprios nas redes.
                  </p>
                )}
              </Chart>
            </div>
          );
        })}
      </div>
      <details class="data-table">
        <summary>Ver os números</summary>
        <div class="table-wrap">
          <table class="t">
            <thead><tr><th>Setor</th><th>Marca</th><th class="num">Fatia</th></tr></thead>
            <tbody>
              {elos.flatMap((e) => ranked(e).map((m) => (
                <tr><td>{shortName(e)}</td><td class="name"><a href={brandUrl(e, m)}>{m.nome}</a></td><td class="num">{m.total === null ? "sem nota" : fatia(m.total)}</td></tr>
              )))}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <h2 style="max-width:22ch;">Seis descobertas</h2>

      <article class="reading" style="margin-top:64px;">
        <div>
          <div class="reading-num">1</div>
          <h3>Ser muito buscada não é o mesmo que conversar com o público.</h3>
          <p>Nas máquinas e nos fertilizantes, a marca mais encontrada não é a que mais conversa com quem a segue.</p>
        </div>
        <div>
          <div class="multiples two">
            {elos.map((e) => (
              <div class="multiple">
                <h4>{e.nome}</h4>
                <Chart payload={slopePayload(e)} label={`Ser encontrada e manter a conversa, por marca, em ${e.nome}`} />
              </div>
            ))}
          </div>
          <div class="table-wrap" style="margin-top:28px;">
            <table class="t">
              <caption>Quem lidera cada pilar</caption>
              <thead><tr><th></th>{elos.map((e) => <th>{shortName(e)}</th>)}</tr></thead>
              <tbody>
                {PILARES.map((p) => (
                  <tr>
                    <td><span class="swatch" style={`display:inline-block;margin-right:8px;background:var(--p-${p.id})`}></span>{p.simples}</td>
                    {elos.map((e) => {
                      const m = pillarLeader(e, p.id);
                      return <td><a href={brandUrl(e, m)}>{m.nome}</a></td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </article>

      <article class="reading" style="margin-top:96px;">
        <div>
          <div class="reading-num">2</div>
          <h3>As IAs lembram sempre das mesmas marcas.</h3>
          <p>Quando o produtor pergunta ao ChatGPT ou ao Gemini, poucas marcas aparecem primeiro. Quem não é citada primeiro quase nunca aparece depois.</p>
          <ul class="legend">
            <li><span class="swatch" style="background:var(--brand-ink)"></span>Citada primeiro</li>
            <li><span class="swatch" style="border:1.5px solid var(--ink-2)"></span>Citada</li>
          </ul>
        </div>
        <div class="multiples two">
          {elos.map((e) => (
            <div class="multiple">
              <h4>{e.nome}</h4>
              <Chart payload={dumbbellPayload(e)} label={`Quanto as IAs citam cada marca em ${e.nome}`} />
            </div>
          ))}
        </div>
      </article>

      <article class="reading" style="margin-top:96px;">
        <div>
          <div class="reading-num">3</div>
          <h3>Poucas marcas respondem a quem comenta.</h3>
          <p>Em cada setor, só duas marcas respondem mais da metade dos comentários no Instagram. Quase metade responde menos de 1 em cada 10.</p>
          <p class="small muted">Cada ponto é uma marca.</p>
        </div>
        <Chart payload={resposta} label="Quanto cada marca responde aos comentários no Instagram, por setor">
          <div slot="table" class="table-wrap">
            <table class="t">
              <thead><tr><th>Setor</th><th>Marca</th><th class="num">Comentários respondidos</th></tr></thead>
              <tbody>{elos.flatMap((e) => [...e.marcas].sort((a, b) => (b.resposta.porComentario ?? -1) - (a.resposta.porComentario ?? -1)).map((m) => <tr><td>{shortName(e)}</td><td>{m.nome}</td><td class="num">{pct(m.resposta.porComentario, 0)}</td></tr>))}</tbody>
            </table>
          </div>
        </Chart>
      </article>

      <article class="reading" style="margin-top:96px;">
        <div>
          <div class="reading-num">4</div>
          <h3>Em buscas gerais, o produtor encontra sites de conteúdo, não fabricantes.</h3>
          <p>Quem pesquisa "fungicida soja" ou "trator para soja" vê primeiro portais, institutos de pesquisa e vídeos.</p>
          <p class="small muted">Cada ponto é uma marca: em quantas dessas buscas ela aparece entre os 10 primeiros resultados.</p>
        </div>
        <Chart payload={categoria} label="Em quantas buscas gerais cada marca aparece no topo do Google, por setor">
          <div slot="table" class="table-wrap">
            <table class="t">
              <thead><tr><th>Setor</th><th>Marca</th><th class="num">Buscas em que aparece</th></tr></thead>
              <tbody>{elos.flatMap((e) => [...e.marcas].sort((a, b) => (b.categoriaTop10 ?? -1) - (a.categoriaTop10 ?? -1)).map((m) => <tr><td>{shortName(e)}</td><td>{m.nome}</td><td class="num">{pct(m.categoriaTop10, 0)}</td></tr>))}</tbody>
            </table>
          </div>
        </Chart>
      </article>

      <article class="reading" style="margin-top:96px;">
        <div>
          <div class="reading-num">5</div>
          <h3>A imprensa fala de poucas marcas.</h3>
          <p>Nos fertilizantes, duas marcas aparecem em quase 3 de cada 4 notícias.</p>
        </div>
        <Chart payload={imprensa} label="Quanto das notícias fica com as duas marcas mais citadas, por setor">
          <ul slot="legend" class="legend">
            <li><span class="swatch" style="background:var(--brand-ink)"></span>Mais citada</li>
            <li><span class="swatch" style="background:var(--seq-2)"></span>Segunda</li>
            <li><span class="swatch" style="background:var(--paper-3)"></span>Todas as outras</li>
          </ul>
          <div slot="table" class="table-wrap">
            <table class="t">
              <thead><tr><th>Setor</th><th>Marca</th><th class="num">Notícias em 1 ano</th></tr></thead>
              <tbody>{elos.flatMap((e) => [...e.marcas].sort((a, b) => (b.materias ?? -1) - (a.materias ?? -1)).map((m) => <tr><td>{shortName(e)}</td><td>{m.nome}</td><td class="num">{int(m.materias)}</td></tr>))}</tbody>
            </table>
          </div>
        </Chart>
      </article>

      <article class="reading" style="margin-top:96px;">
        <div>
          <div class="reading-num">6</div>
          <h3>Nos sites, o básico quase todos têm. A diferença está na velocidade.</h3>
          <p>Onde comprar, contato e catálogo aparecem em quase todos. O que muda é a rapidez das páginas. Nos fertilizantes, é o contrário.</p>
          <p class="small muted">Nota de 0 a 100. Cada ponto é uma marca.</p>
        </div>
        <div class="multiples two">
          {elos.map((e) => (
            <div class="multiple">
              <h4>{e.nome}</h4>
              <Chart payload={sitePayload(e)} label={`Recursos e velocidade dos sites em ${e.nome}`} />
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="prose">
        <h2>Abaixo do líder, <em>muitas marcas empatam.</em></h2>
        <p class="lead">Chance de cada marca ficar em cada posição. Quanto mais escura a célula, mais certa a posição.</p>
      </div>
      <ul class="legend" style="margin-top:32px;">
        <li><span class="swatch" style="border-radius:2px;background:var(--seq-0)"></span>quase nenhuma chance</li>
        <li><span class="swatch" style="border-radius:2px;background:var(--seq-2)"></span>chance média</li>
        <li><span class="swatch" style="border-radius:2px;background:var(--seq-4)"></span>quase certo</li>
      </ul>
      <div class="multiples two" style="margin-top:12px;">
        {elos.map((e) => (
          <div class="multiple">
            <h4><a href={url(`/elos/${e.slug}/`)}>{e.nome}</a><span>posição</span></h4>
            <Chart payload={positionsPayload(e)} label={`Chance de cada marca em cada posição, ${e.nome}`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--paper-2);">
    <div class="page grid-2" style="align-items:end;">
      <div>
        <h2>Ficou alguma dúvida? <em>Pergunte.</em></h2>
        <p class="lead">O assistente responde com base no estudo e mostra de onde veio cada informação.</p>
      </div>
      <div class="chips" style="flex-direction:column;align-items:flex-start;">
        {perguntas.map((q) => <a class="chip" href={url(`/pergunte/?q=${encodeURIComponent(q)}`)}>{q}</a>)}
        <a class="btn primary" style="margin-top:14px;" href={url("/pergunte/")}>Fazer outra pergunta</a>
      </div>
    </div>
  </section>
</Base>
