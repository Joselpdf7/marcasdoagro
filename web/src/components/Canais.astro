---
// Five channel indicators as small multiples of ranked bars. Descriptive: they are
// not added to the total (each is already a measure inside a pillar).
import type { Elo, Marca } from "../lib/types.ts";
import { brandUrl } from "../lib/data.ts";
import { pct, int, compact } from "../lib/format.ts";

interface Props { elo: Elo }
const { elo } = Astro.props;

const canais: { titulo: string; sub: string; pick: (m: Marca) => number | null; fmt: (v: number) => string }[] = [
  { titulo: "Citada pelas IAs", sub: "% das respostas", pick: (m) => m.ia.mencao, fmt: (v) => pct(v, 0) },
  { titulo: "Responde comentários", sub: "% dos comentários", pick: (m) => m.resposta.porComentario, fmt: (v) => pct(v, 0) },
  { titulo: "Aparece em buscas gerais", sub: "% das buscas", pick: (m) => m.categoriaTop10, fmt: (v) => pct(v, 0) },
  { titulo: "Notícias", sub: "matérias em 1 ano", pick: (m) => m.materias, fmt: (v) => int(v) },
  { titulo: "Instagram", sub: "seguidores", pick: (m) => m.seguidores.instagram, fmt: (v) => compact(v) },
];
---
<div class="canais">
  {canais.map((c) => {
    const rows = elo.marcas
      .map((m) => ({ m, v: c.pick(m) }))
      .sort((a, b) => (b.v ?? -1) - (a.v ?? -1));
    const max = Math.max(...rows.map((r) => r.v ?? 0), 1);
    return (
      <div class="canal">
        <h4>{c.titulo}<span>{c.sub}</span></h4>
        <ol>
          {rows.map((r, i) => (
            <li class:list={{ top: i === 0 && r.v !== null }}>
              <a href={brandUrl(elo, r.m)}>{r.m.nome}</a>
              <span class="bar"><span style={`width:${r.v === null ? 0 : Math.max(2, (r.v / max) * 100)}%`}></span></span>
              <span class="v">{r.v === null ? "—" : c.fmt(r.v)}</span>
            </li>
          ))}
        </ol>
      </div>
    );
  })}
</div>

<style>
  .canais {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 32px 28px;
  }
  .canal h4 {
    font: 600 13px/1.3 var(--sans);
    color: var(--ink);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-strong);
    margin: 0 0 6px;
    display: flex;
    flex-direction: column;
  }
  .canal h4 span {
    font-weight: 400;
    color: var(--ink-3);
    font-size: 12px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 1fr 44px 58px;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    padding: 4px 0;
  }
  li a {
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  li a:hover {
    color: var(--brand-ink);
    text-decoration: underline;
  }
  .bar {
    height: 6px;
    background: var(--paper-3);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--ink-3);
    border-radius: 3px;
  }
  .v {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }
  li.top a,
  li.top .v {
    color: var(--brand-ink);
    font-weight: 600;
  }
  li.top .bar span {
    background: var(--brand-ink);
  }
</style>
