---
// Pillar triangle: each corner is a pillar; the further the coloured dot from the
// centre, the stronger the brand there. Dashed triangle = sector average.
// The brand's share sits in the centre when it fits, otherwise just below the shape,
// so it never covers the drawing.
import { fatia, n } from "../lib/format.ts";
import { PILARES } from "../lib/meta.ts";
import type { Pilar } from "../lib/types.ts";

interface Props {
  nome: string;
  href?: string;
  pilares: Record<Pilar, number | null>;
  total: number | null;
  max: number;
  referencia: number;
  destaque?: boolean;
  size?: number;
  /** "propria": scale to the brand's own strongest pillar (profile view). */
  escala?: "painel" | "propria";
}
const { nome, href, pilares, total, max: panelMax, referencia, destaque = false, size = 260, escala = "painel" } = Astro.props;
const own = Math.max(referencia, ...Object.values(pilares).filter((v): v is number => v !== null));
const max = escala === "propria" ? own * 1.1 : panelMax;

const W = 200;
const H = 176;
const c = { x: 100, y: 102 };
const R = 88;
const angle: Record<Pilar, number> = { proeminencia: -90, valorizacao: 30, fidelidade: 150 };
const ids: Pilar[] = ["proeminencia", "valorizacao", "fidelidade"];
const pt = (p: Pilar, v: number) => {
  const a = (angle[p] * Math.PI) / 180;
  const r = (Math.min(v, max) / max) * R;
  return { x: c.x + r * Math.cos(a), y: c.y + r * Math.sin(a), r };
};
const poly = (vals: [Pilar, number][]) => vals.map(([p, v]) => pt(p, v)).map((q) => `${q.x.toFixed(1)},${q.y.toFixed(1)}`).join(" ");
const data = ids.flatMap((p) => (pilares[p] === null ? [] : [[p, pilares[p]] as [Pilar, number]]));
const pts = data.map(([p, v]) => pt(p, v));

// Number placement: centre if every corner of the shape is far enough, else under the shape.
const fits = pts.length === 3 && Math.min(...pts.map((q) => q.r)) >= 26;
const centroid = pts.length === 3 ? { x: pts.reduce((a, q) => a + q.x, 0) / 3, y: pts.reduce((a, q) => a + q.y, 0) / 3 } : c;
const numX = fits ? centroid.x : c.x;
const numY = fits ? centroid.y + 6 : Math.max(c.y + 6, ...pts.map((q) => q.y)) + 18;

const ink = destaque ? "var(--brand-ink)" : "var(--ink-2)";
const desc = `${nome}: fatia de ${fatia(total)}. ${PILARES.map((p) => `${p.simples}: ${n(pilares[p.id])}`).join(". ")}.`;
const Tag = href ? "a" : "div";
---
<Tag class:list={["tri", { destaque }]} href={href} style={`--tri-size:${size}px`}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={desc}>
    <title>{desc}</title>
    <polygon points={poly(ids.map((p) => [p, max]))} fill="none" stroke="var(--rule-strong)" stroke-width="1" />
    {ids.map((p) => {
      const q = pt(p, max);
      return <line x1={c.x} y1={c.y} x2={q.x} y2={q.y} stroke="var(--rule)" stroke-width="1" />;
    })}
    <polygon points={poly(ids.map((p) => [p, referencia]))} fill="none" stroke="var(--ink-3)" stroke-width="1" stroke-dasharray="3 3" />
    {data.length === 3 ? (
      <polygon points={poly(data)} fill={ink} fill-opacity={destaque ? 0.14 : 0.07} stroke={ink} stroke-width={destaque ? 2 : 1.5} stroke-linejoin="round" />
    ) : (
      data.length === 2 && <polyline points={poly(data)} fill="none" stroke={ink} stroke-width="1.5" />
    )}
    {pts.map((q, i) => (
      <circle cx={q.x} cy={q.y} r="4" fill={`var(--p-${data[i]![0]})`} stroke="var(--paper)" stroke-width="1.5" />
    ))}
    <text x={numX} y={numY} text-anchor="middle" class="tri-total">{total === null ? "sem nota" : fatia(total)}</text>
  </svg>
  {nome && <span class="tri-name">{nome}</span>}
</Tag>

<style>
  .tri {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
    width: 100%;
    max-width: var(--tri-size);
    margin: 0 auto;
  }
  .tri svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .tri-total {
    font: 500 15px var(--sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .destaque .tri-total {
    fill: var(--brand-ink);
    font-weight: 600;
    font-size: 17px;
  }
  .tri-name {
    font: 500 15px/1.2 var(--sans);
    margin-top: 4px;
    text-align: center;
  }
  .destaque .tri-name {
    color: var(--brand-ink);
    font-weight: 600;
  }
  a.tri:hover .tri-name {
    text-decoration: underline;
  }
</style>
